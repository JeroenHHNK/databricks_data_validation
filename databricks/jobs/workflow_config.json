{
  "name": "groundwater_source_replication",
  "description": "Self-contained Databricks job: pulls this repo from GitHub (git_source), copies the current source data into the personal schema, and writes output_databricks/ CSVs back to the repo. Uses a Databricks-managed job cluster (no external cluster, no laptop driver). 03_validated_to_delta runs separately, after human review.",
  "tags": { "pipeline": "data_validation", "owner": "jvanruitenbeek" },
  "git_source": {
    "git_url": "https://github.com/JeroenHHNK/databricks_data_validation",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "job_clusters": [
    {
      "job_cluster_key": "default",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "autoscale": { "min_workers": 1, "max_workers": 2 },
        "data_security_mode": "SINGLE_USER",
        "spark_conf": { "spark.databricks.delta.schema.autoMerge.enabled": "true" }
      }
    }
  ],
  "parameters": [
    { "name": "output_catalog", "default": "waterkeringbeheer_prd" },
    { "name": "output_schema", "default": "jvanruitenbeek" },
    { "name": "branch", "default": "main" },
    { "name": "limit_series", "default": "3" },
    { "name": "run_id", "default": "" },
    { "name": "git_token_secret", "default": "gh/pat" }
  ],
  "tasks": [
    {
      "task_key": "probe_env",
      "job_cluster_key": "default",
      "notebook_task": {
        "notebook_path": "databricks/notebooks/00_probe_env",
        "source": "GIT",
        "base_parameters": {
          "output_catalog": "{{job.parameters.output_catalog}}",
          "output_schema": "{{job.parameters.output_schema}}",
          "branch": "{{job.parameters.branch}}",
          "git_token_secret": "{{job.parameters.git_token_secret}}"
        }
      }
    },
    {
      "task_key": "source_to_personal",
      "depends_on": [{ "task_key": "probe_env" }],
      "job_cluster_key": "default",
      "notebook_task": {
        "notebook_path": "databricks/notebooks/01_source_to_personal",
        "source": "GIT",
        "base_parameters": {
          "output_catalog": "{{job.parameters.output_catalog}}",
          "output_schema": "{{job.parameters.output_schema}}",
          "limit_series": "{{job.parameters.limit_series}}",
          "run_id": "{{job.parameters.run_id}}"
        }
      }
    },
    {
      "task_key": "export_to_git",
      "depends_on": [{ "task_key": "source_to_personal" }],
      "job_cluster_key": "default",
      "notebook_task": {
        "notebook_path": "databricks/notebooks/02_export_to_git",
        "source": "GIT",
        "base_parameters": {
          "output_catalog": "{{job.parameters.output_catalog}}",
          "output_schema": "{{job.parameters.output_schema}}",
          "transport": "write",
          "branch": "{{job.parameters.branch}}",
          "git_token_secret": "{{job.parameters.git_token_secret}}",
          "run_id": "{{tasks.source_to_personal.values.run_id}}"
        }
      }
    }
  ]
}
